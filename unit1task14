# Operator precedence: multiplication is evaluated before addition
result1 = 2 + 3 * 4
print("2 + 3 * 4 =", result1)

# Parentheses change the order
result2 = (2 + 3) * 4
print("(2 + 3) * 4 =", result2)

# Associativity: exponentiation groups from right to left
result3 = 2 ** 3 ** 2
print("2 ** 3 ** 2 =", result3)  # 2 ** (3 ** 2) = 512

# Most arithmetic operators group from left to right
result4 = 20 - 5 - 3
print("20 - 5 - 3 =", result4)  # (20 - 5) - 3 = 12