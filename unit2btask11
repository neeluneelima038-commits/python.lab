number = int(input("Enter a 3-digit number: "))

if 100 <= number <= 999:
    original = number
    total = 0

    while number > 0:
        digit = number % 10
        total += digit ** 3
        number //= 10

    if total == original:
        print("Armstrong number")
    else:
        print("Not an Armstrong number")
else:
    print("Please enter a 3-digit number.")